@baseUrl = http://localhost:5050

### List tasks
GET {{baseUrl}}/api/tasks

### Create a task
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Plan the week",
  "notes": "Choose three priorities",
  "priority": "High",
  "dueDate": "2026-11-16",
  "isCompleted": false
}

### Get a task (replace ID with one returned by create)
GET {{baseUrl}}/api/tasks/1

### Edit and complete a task
PUT {{baseUrl}}/api/tasks/1
Content-Type: application/json

{
  "title": "Plan the week",
  "notes": "Done",
  "priority": "High",
  "dueDate": null,
  "isCompleted": true
}

### Delete a task
DELETE {{baseUrl}}/api/tasks/1

### Missing task
GET {{baseUrl}}/api/tasks/0

### Invalid title
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{ "title": "   " }

### Create a recurring task (due date is optional)
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Weekly review",
  "notes": "Review progress and plan next steps",
  "priority": "Medium",
  "recurrence": "Weekly"
}

### Complete a recurring occurrence (replace ID with the returned ID)
# Creates the next occurrence due seven days after completion, in server time.
PUT {{baseUrl}}/api/tasks/2
Content-Type: application/json

{
  "title": "Weekly review",
  "notes": "Review progress and plan next steps",
  "priority": "Medium",
  "recurrence": "Weekly",
  "isCompleted": true
}
